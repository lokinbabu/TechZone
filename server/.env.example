# ---- TechZone API environment ----
# Copy this file to `.env` and adjust values.

# MongoDB connection string.
# Local MongoDB:  mongodb://127.0.0.1:27017/techzone
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>/techzone?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/techzone

# Port the API listens on
PORT=5000

# Secret used to sign JWTs — set this to a long random string in production
JWT_SECRET=replace-this-with-a-long-random-secret-string

# Days until issued tokens expire
JWT_EXPIRES_IN=7

# Seeded demo admin (used by `npm run seed` only)
ADMIN_NAME=TechZone Admin
ADMIN_EMAIL=admin@techzone.com
ADMIN_PASSWORD=Admin@123
